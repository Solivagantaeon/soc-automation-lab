{
  "description": "Settings and named connections in the existing triage workflow. Input numbers match the n8n editor (1-based). This file is a configuration reference.",
  "misp": {
    "node": "Get a filtered list of attributes",
    "resource": "attribute",
    "operation": "search",
    "useJson": true,
    "jsonOutput": "={{ {\n  \"value\": $json.observables.map(observable => observable.data),\n  \"includeEventTags\": true\n} }}",
    "onSuccess": "Merge input 1",
    "onError": "Error Formatter - MISP"
  },
  "cortex": {
    "batchSize": 1,
    "reset": false,
    "initialWaitSeconds": 2,
    "retryWaitSeconds": 2,
    "jobId": "={{ $json._id ?? $json.id }}",
    "waitingCondition": "={{ ['waiting', 'inprogress'].includes(String($json.status ?? '').toLowerCase()) ||\n   (typeof $json.report === 'string' &&\n    ['waiting', 'inprogress'].includes($json.report.toLowerCase())) }}",
    "retryCondition": "={{ $runIndex < 6 }}",
    "connections": {
      "loop": "Execute on the loop output. Send the done output to the assigned final Merge input.",
      "execute": "Send success to the initial Wait, then Get a report. Send errors from Execute and Get a report to the same formatter.",
      "waiting": "Send true to the retry Wait and then to the limit check. Send false to the branch Merge on input 2.",
      "limit": "Send true to Get a report. Send false to the branch Merge on input 1.",
      "branchMerge": "Append mode, three inputs. Send formatter output to input 3. Connect the branch Merge output back to its Loop Over Items node."
    },
    "routes": [
      {
        "loop": "Loop Over Items Multiverse",
        "execute": "Execute Maltiverse",
        "initialWait": "WaitMalti1",
        "report": "Get a report  Maltiverse",
        "waiting": "Report Malti still waiting?",
        "retryWait": "WaitMalti",
        "limit": "Malti limit not reached?",
        "errorFormatter": "Error Formatter - Maltiverse",
        "branchMerge": "MergeMaltiverse",
        "finalMergeInput": 2
      },
      {
        "loop": "Loop Over Items Abuse",
        "execute": "Execute AbuseIPDB",
        "initialWait": "WaitAbuse1",
        "report": "Get a report AbuseIPBD",
        "waiting": "Report Abuse still waiting?",
        "retryWait": "WaitAbuse",
        "limit": "Abuse limit not reached?",
        "errorFormatter": "Error Formatter - AbuseIDPB",
        "branchMerge": "MergeAbusIPBD",
        "finalMergeInput": 3
      },
      {
        "loop": "Loop Over Items TeamCymru",
        "execute": "Execute TeamCymru",
        "initialWait": "WaitCymru1",
        "report": "Get a report TeamCymru",
        "waiting": "Report Cymru still waiting?",
        "retryWait": "WaitCymru",
        "limit": "Cymru limit not reached?",
        "errorFormatter": "Error Formatter - TeamCymru",
        "branchMerge": "MergeTeamCymru",
        "finalMergeInput": 5
      },
      {
        "loop": "Loop Over Items Circl",
        "execute": "Execute CirclHash",
        "initialWait": "WaitCircl1",
        "report": "Get a report CirclHash",
        "waiting": "Report Circl still waiting?",
        "retryWait": "WaitCircl",
        "limit": "Circl limit not reached?",
        "errorFormatter": "Error Formatter - CirclHash",
        "branchMerge": "MergeCirclHash",
        "finalMergeInput": 6
      },
      {
        "loop": "Loop Over Items Virus",
        "execute": "Execute VirusTotal",
        "initialWait": "WaitVirus1",
        "report": "Get a report UnshortenLink",
        "waiting": "Report virus still waiting?",
        "retryWait": "WaitVirus",
        "limit": "Virus limit not reached?",
        "errorFormatter": "Error Formatter - VirusTotal",
        "branchMerge": "MergeVirusTotal",
        "finalMergeInput": 7
      }
    ]
  },
  "finalMerge": {
    "node": "Merge",
    "mode": "append",
    "inputs": {
      "1": "Get a filtered list of attributes",
      "2": "Loop Over Items Multiverse",
      "3": "Loop Over Items Abuse",
      "4": "Filter Cortex-Eligible IPs",
      "5": "Loop Over Items TeamCymru",
      "6": "Loop Over Items Circl",
      "7": "Loop Over Items Virus",
      "8": "Mark Cortex skipped",
      "9": "Error Formatter - MISP"
    },
    "output": "Summary Enrichments"
  }
}
