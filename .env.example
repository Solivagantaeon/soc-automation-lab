# Copy to .env (ignored by git) and fill in locally. Never commit real values.
WAZUH_API_URL=https://wazuh.lab:55000
WAZUH_API_USER=<WAZUH_API_USER>
WAZUH_API_PASSWORD=<WAZUH_API_PASSWORD>

SHUFFLE_URL=https://shuffle.lab:3443
SHUFFLE_WEBHOOK_URL=<SHUFFLE_WEBHOOK_URL>

CORTEX_URL=http://<THEHIVE_CORTEX_HOST>:9001/cortex
CORTEX_API_KEY=<CORTEX_API_KEY>

THEHIVE_URL=http://<THEHIVE_CORTEX_HOST>/thehive
THEHIVE_API_KEY=<THEHIVE_API_KEY>

MISP_URL=https://<MISP_HOST>
MISP_API_KEY=<MISP_API_KEY>
MISP_VERIFY_TLS=false
