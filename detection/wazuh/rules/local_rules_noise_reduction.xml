<!--
  Wazuh 4.14 - noise reduction rules (v2, 2026-10-10; rule 100922 added 2026-11-15)
  Hosts: SOC-DC01 (Server 2022), SOC-WIN10-01 (Win10), SOC-WIN11-AI (Win11), wazuh-master, opnsense
  Deployed to /var/ossec/etc/rules/ on the Wazuh manager (loaded by <rule_dir>etc/rules</rule_dir>).

  v2 - changes since v1:
    * FIX: the path regexes (100120-100123) did not match. Wazuh stores eventchannel
      fields with double backslashes (C:\\Windows\\...), while v1 looked for single
      ones. Every path separator is now \\+ (one or more backslashes), so the rules
      match regardless of escaping.
    * New: SoftLandingTask / MoUsoCoreWorker (taskschd), __PSScriptPolicyTest_* test
      files, the Wazuh agent SCA scan (secedit/net user/reg query), agent restart by
      active response, Edge shortcuts, DismHost, Windows Update, Sysmon EID 13 for Edge,
      network logoffs, per-user services in FIM, Suricata ET INFO azurewebsites from the DC.
    * Based on: alerts 09.10 18:13 - 10.10 08:07 (1000 alerts) and Sysmon logs read
      directly on SOC-WIN11-AI.
-->

<!-- ===================================================================== -->
<!--  1. Windows logons / logoffs                                           -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,windows,authentication_success,">

  <rule id="100100" level="0">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.targetUserName" type="pcre2">\$$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <description>NOISE: Network logon of machine account $(win.eventdata.targetUserName)</description>
  </rule>

  <rule id="100101" level="0">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.logonType">^5$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(SYSTEM|LOCAL SERVICE|NETWORK SERVICE)$</field>
    <description>NOISE: Service logon of built-in account $(win.eventdata.targetUserName)</description>
  </rule>

  <rule id="100102" level="0">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(DWM|UMFD)-\d+$</field>
    <description>NOISE: Logon of virtual account $(win.eventdata.targetUserName)</description>
  </rule>

  <!-- NEW in v2: Event 4634 (60137), about 2/h on WIN11 and WIN10, the logoff pair of
       the suppressed network/service logons. Interactive (2), RDP (10), unlock (7)
       and cached (11) logoffs still raise alerts. -->
  <rule id="100103" level="0">
    <if_sid>60137</if_sid>
    <field name="win.eventdata.logonType" type="pcre2">^(3|4|5)$</field>
    <description>NOISE: Logoff of network/service session (type $(win.eventdata.logonType))</description>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  2. Event 4688 - duplicate of Sysmon EID 1 (since v1)                  -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,windows,">
  <rule id="100110" level="0">
    <if_sid>67027</if_sid>
    <description>NOISE: Event 4688 - covered by Sysmon EID 1</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  3. Sysmon EID 7 - taskschd.dll (92154)                                -->
<!--     On WIN11 since 18:00: SoftLandingTask 80, taskhostw 43, sppsvc 42,  -->
<!--     EdgeUpdate 41, MoUsoCoreWorker 33, svchost 21                       -->
<!--     NOT excluded: schtasks, powershell, cmd, mshta, rundll32,           -->
<!--     wscript/cscript, regsvr32, OneDrive (path writable by the user)     -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid7_detections,">

  <rule id="100120" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+System32\\+(svchost|taskhostw|sppsvc|MoUsoCoreWorker|usocoreworker|usoclient|SIHClient|CompatTelRunner|DeviceCensus|wermgr|wuauclt|SearchIndexer|backgroundTaskHost|gpupdate|dsregcmd|provtool)\.exe$</field>
    <description>NOISE: System process $(win.eventdata.image) loaded taskschd.dll</description>
  </rule>

  <rule id="100121" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+ProgramData\\+Microsoft\\+Windows Defender\\+Platform\\+[\d.\-]+\\+(MsMpEng|MpCmdRun|NisSrv)\.exe$</field>
    <description>NOISE: Windows Defender loaded taskschd.dll</description>
  </rule>

  <!-- Edge Update and the Edge installer from Install\{GUID}\EDGEMITMP_*.tmp (Program Files = admin only) -->
  <rule id="100122" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Program Files( \(x86\))?\\+Microsoft\\+EdgeUpdate\\+(MicrosoftEdgeUpdate\.exe|Install\\+\{[0-9A-F\-]{36}\}\\+EDGEMITMP_[0-9A-F]+\.tmp\\+setup\.exe)$</field>
    <description>NOISE: Microsoft Edge Update loaded taskschd.dll</description>
  </rule>

  <!-- Servicing / Update Orchestrator (UUS = Unified Update Stack on Win11) -->
  <rule id="100123" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+(servicing\\+TrustedInstaller|WinSxS\\+[^\\]+\\+TiWorker|UUS\\+(amd64|arm64)\\+MoUsoCoreWorker)\.exe$</field>
    <description>NOISE: Windows servicing/USO loaded taskschd.dll</description>
  </rule>

  <!-- NEW in v2: SoftLandingTask (Windows 11 tips/OOBE), the loudest process on WIN11 -->
  <rule id="100124" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+SystemApps\\+MicrosoftWindows\.Client\.CBS_cw5n1h2txyewy\\+SoftLandingTask\\+SoftLandingTask\.exe$</field>
    <description>NOISE: SoftLandingTask (Win11) loaded taskschd.dll</description>
  </rule>

  <!-- NEW in v2: DismHost loads its providers from C:\Windows\Temp\{GUID}\ (92157).
       Suppressed only when the loaded DLL is validly signed by Microsoft Windows;
       DLL sideloading with an unsigned library still raises an alert. -->
  <rule id="100125" level="0">
    <if_sid>92157</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+Temp\\+[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\+DismHost\.exe$</field>
    <field name="win.eventdata.signed" type="pcre2">(?i)^true$</field>
    <field name="win.eventdata.signature" type="pcre2">^Microsoft Windows$</field>
    <field name="win.eventdata.signatureStatus" type="pcre2">^Valid$</field>
    <description>NOISE: DismHost loaded a signed DISM provider from Temp</description>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  4. Sysmon EID 1 - sdbinst.exe (since v1: 16 runs, 0 alerts)           -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid1_detections,">
  <rule id="100130" level="0">
    <if_sid>92058</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-m\s+-bg(\s|$)|\s-mm(\s|$)</field>
    <description>NOISE: sdbinst.exe started by Windows maintenance (-m -bg / -mm)</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  5. Windows system events (since v1)                                   -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,windows,">
  <rule id="100140" level="0">
    <if_sid>60642</if_sid>
    <description>NOISE: Software Protection Platform - service restart scheduled</description>
  </rule>

  <!-- Confirmed on WIN11: BITS switches auto/demand about 150 times a day, IsolationSession 6 times -->
  <rule id="100141" level="0">
    <if_sid>61104</if_sid>
    <field name="win.eventdata.param4" type="pcre2">(?i)^(BITS|IsolationSession|wuauserv|UsoSvc|TrustedInstaller|WaaSMedicSvc|DoSvc|edgeupdate|edgeupdatem|MicrosoftEdgeElevationService)$</field>
    <description>NOISE: Windows Update/BITS changed the start type of service $(win.eventdata.param4)</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  6. Manager - PAM sessions of sudo (since v1)                          -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,pam,syslog,">
  <rule id="100150" level="0">
    <if_sid>5501,5502</if_sid>
    <program_name>^sudo$</program_name>
    <description>NOISE: PAM session opened/closed by sudo (duplicate of 5402)</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  7. NEW in v2: PowerShell __PSScriptPolicyTest_*                       -->
<!--     Every PowerShell start creates a pair of AppLocker test files      -->
<!--     (.ps1 + .psm1) in Temp/SystemTemp. The Wazuh agent (SCA) starts     -->
<!--     PowerShell about 11 times per scan, so:                            -->
<!--       WIN11: 92205 "executable in Windows root" (SystemTemp is under    -->
<!--              C:\Windows), 11 alerts per scan                            -->
<!--       DC:    92201 "scripting file under Windows Temp", 12 alerts       -->
<!--     The file name has a fixed format: 8 chars.3 chars.ps1/psm1          -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid11_detections,">
  <rule id="100160" level="0">
    <if_sid>92200,92201,92203,92204,92205</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+(System32|SysWOW64)\\+WindowsPowerShell\\+v1\.0\\+powershell\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+(Windows\\+(SystemTemp|Temp)|AppData\\+Local\\+Temp)\\+__PSScriptPolicyTest_[a-z0-9]{8}\.[a-z0-9]{3}\.psm?1$</field>
    <description>NOISE: PowerShell created an AppLocker policy test file</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  8. NEW in v2: Wazuh agent - SCA scan and restart by active response   -->
<!--     wazuh-agent.exe (32-bit) runs on every scan: secedit to secpol.cfg, -->
<!--     net user, reg query legalnotice*, Get-CimInstance Win32_UserAccount -->
<!--     which raise 92021 (Remove-Item), 92031 (Discovery), 92039 etc.      -->
<!--     Suppressed ONLY for the exact command lines of the SCA policy with  -->
<!--     wazuh-agent.exe as the parent. Any other command under the agent    -->
<!--     (e.g. a compromised manager pushing commands) still raises alerts.  -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid1_detections,wazuh_agent,">

  <rule id="100170" level="0">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)^C:\\+Program Files \(x86\)\\+ossec-agent\\+wazuh-agent\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^(powershell secedit /export /cfg \$env:TEMP\\+secpol\.cfg; Get-Content \$env:TEMP\\+secpol\.cfg \| Select-String \\*"[A-Za-z]+\\*"; Remove-Item \$env:TEMP\\+secpol\.cfg|net user|reg query HKLM\\+SOFTWARE\\+Microsoft\\+Windows\\+CurrentVersion\\+Policies\\+system /v legalnotice(caption|text))$</field>
    <description>NOISE: Wazuh agent SCA scan: $(win.eventdata.commandLine)</description>
  </rule>

  <!-- Check of the Guest/Administrator accounts (SID -501/-500). The command line is
       long, so only its beginning is anchored. -->
  <rule id="100171" level="0">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)^C:\\+Program Files \(x86\)\\+ossec-agent\\+wazuh-agent\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^powershell -NoProfile -Command \\*"\[bool\]\(Get-CimInstance -Query 'SELECT \* FROM Win32_UserAccount WHERE LocalAccount = TRUE AND SID LIKE ''S-1-5-21-%+-50\d'''</field>
    <description>NOISE: Wazuh agent SCA scan: local account check</description>
  </rule>

  <!-- net.exe (32-bit, started by the agent) starts net1.exe, a grandchild of the agent.
       Requires the 32-bit SysWOW64 chain and exactly "net user". -->
  <rule id="100172" level="0">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+SysWOW64\\+net1\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)^C:\\+Windows\\+SysWOW64\\+net\.exe$</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)^net user$</field>
    <description>NOISE: Wazuh agent SCA scan: net1 user</description>
  </rule>

  <!-- Agent restart after an agent.conf change / from the manager: restart-wazuh.exe starts
       cmd /c net stop|start Wazuh (92052 "cmd started by abnormal process", 21:23 on WIN11).
       "net stop Wazuh" from any other parent STILL raises an alert (T1562.001). -->
  <rule id="100173" level="0">
    <if_sid>92052</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)^C:\\+Program Files \(x86\)\\+ossec-agent\\+active-response\\+bin\\+restart-wazuh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)cmd\.exe /c %+WINDIR%+\\+system32\\+net\.exe (stop|start) Wazuh$</field>
    <description>NOISE: Wazuh agent active response restarts the service</description>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  9. NEW in v2: files created by installers/updates (EID 11)            -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid11_detections,">

  <!-- The Edge installer creates "Microsoft Edge.lnk" in Users\Public\Desktop (92207, level 12)
       and in systemprofile\...\Quick Launch (92217). WIN11, 03:17. -->
  <rule id="100175" level="0">
    <if_sid>92207,92217</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Program Files( \(x86\))?\\+Microsoft\\+EdgeUpdate\\+Install\\+\{[0-9A-F\-]{36}\}\\+EDGEMITMP_[0-9A-F]+\.tmp\\+setup\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+Microsoft Edge\.lnk$</field>
    <description>NOISE: Edge installer created the Microsoft Edge.lnk shortcut</description>
  </rule>

  <!-- Windows Update (svchost/wuauserv) downloads packages to SoftwareDistribution\Download
       (e.g. AM_Delta_Patch_*.exe for Defender). [VERIFY] matched by time to 92217 at 18:27 -->
  <rule id="100176" level="0">
    <if_sid>92217,92218</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+System32\\+svchost\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)^C:\\+Windows\\+SoftwareDistribution\\+Download\\+</field>
    <description>NOISE: Windows Update downloaded a package to SoftwareDistribution</description>
  </rule>

  <!-- Servicing on the DC: 29x 92217 at 00:16:58 together with DismHost in C:\Windows\Temp\{GUID}.
       [VERIFY] the image/targetFilename fields on the DC (that VM was not reachable).
       DismHost.exe in Temp is deliberately NOT accepted as "image": C:\Windows\Temp is writable. -->
  <rule id="100177" level="0">
    <if_sid>92217,92218,92219</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Windows\\+(servicing\\+TrustedInstaller|WinSxS\\+[^\\]+\\+TiWorker|System32\\+Dism\\+DismHost|System32\\+Dism)\.exe$</field>
    <description>NOISE: Windows servicing wrote binaries to the Windows folder</description>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  10. NEW in v2: Sysmon EID 13 - 92307 "new service creation" for Edge  -->
<!--      The rule fires on every write under \Services\, including firewall -->
<!--      rules (SharedAccess\...\FirewallRules) and the ImagePath of the    -->
<!--      Edge service.                                                      -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,sysmon,sysmon_eid13_detections,">

  <rule id="100180" level="0">
    <if_sid>92307</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Services\\+SharedAccess\\+Parameters\\+FirewallPolicy\\+(RestrictedServices\\+AppIso\\+)?FirewallRules\\+</field>
    <field name="win.eventdata.details" type="pcre2">(?i)\|App=C:\\+Program Files \(x86\)\\+Microsoft\\+Edge\\+Application\\+msedge\.exe\|</field>
    <description>NOISE: Edge added a firewall rule (mDNS)</description>
  </rule>

  <rule id="100181" level="0">
    <if_sid>92307</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Services\\+MicrosoftEdgeElevationService\\+ImagePath$</field>
    <field name="win.eventdata.details" type="pcre2">(?i)^\\*"?C:\\+Program Files \(x86\)\\+Microsoft\\+Edge\\+Application\\+[\d.]+\\+elevation_service\.exe\\*"?$</field>
    <description>NOISE: Edge update changed the ImagePath of elevation_service</description>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  11. NEW in v2: registry FIM - per-user services                       -->
<!--      Windows 10/11 creates service instances <Name>_<LUID hex>, e.g.    -->
<!--      CDPUserSvc_f8b987a, at every logon and deletes them at logoff,     -->
<!--      which gives "Registry Key Entry Added/Deleted" on every scan.      -->
<!--      The rest of the FIM noise is excluded in agent.conf               -->
<!--      (registry_ignore), see detection/wazuh/agent-config/agent.conf.    -->
<!--      [VERIFY] after deployment: the "file" field = syscheck.path        -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,syscheck,syscheck_registry,">
  <rule id="100185" level="0">
    <if_sid>594,597,598,750,751,752</if_sid>
    <field name="file" type="pcre2">(?i)^HKEY_LOCAL_MACHINE\\+System\\+CurrentControlSet\\+Services\\+[A-Za-z0-9]+_[0-9a-f]{5,8}(\\+.*)?$</field>
    <description>NOISE: FIM - per-user service instance $(file)</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  12. NEW in v2: Suricata (opnsense)                                    -->
<!-- ===================================================================== -->
<group name="local,noise_reduction,ids,suricata,">
  <!-- The DC (10.10.10.200) is the DNS resolver of the lab, so every Windows/Edge query
       for *.azurewebsites.net looks as if it came from the DC. Queries from other hosts
       still raise alerts. -->
  <rule id="100186" level="0">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">^ET INFO Abused Hosting Domain in DNS Lookup \(azurewebsites \.net\)$</field>
    <field name="src_ip">^10\.10\.10\.200$</field>
    <description>NOISE: Suricata - DC (resolver) looked up azurewebsites.net</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  13. Compensating control - alert when Sysmon stops (unchanged)        -->
<!-- ===================================================================== -->
<group name="local,sysmon,service_availability,">

  <!-- param2 is localised by Windows: "zatrzyman" matches the Polish "zatrzymana" (stopped). -->
  <rule id="100190" level="10">
    <if_group>windows_system</if_group>
    <field name="win.system.eventID">^7036$</field>
    <field name="win.eventdata.param1" type="pcre2">(?i)^Sysmon(64)?$</field>
    <field name="win.eventdata.param2" type="pcre2">(?i)stopped|zatrzyman</field>
    <description>Sysmon service stopped on $(agent.name) - telemetry lost</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <rule id="100191" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^4$</field>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.eventdata.state" type="pcre2">(?i)^Stopped$</field>
    <description>Sysmon reported a stop (EID 4) on $(agent.name)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

</group>

<!-- ===================================================================== -->
<!--  14. OneDrive (added 2026-11-15)                                       -->
<!-- ===================================================================== -->
<group name="local,sysmon,noise_reduction,">
  <!-- OneDrive client and its per-user updater open explorer.exe during sync/setup.
       Benign; produced 272 level-12 alerts in 8 s after a first logon (2026-11-15). -->
  <rule id="100922" level="0">
    <if_sid>92910</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)appdata.{1,2}local.{1,2}microsoft.{1,2}onedrive.{1,2}(update.{1,2})?onedrive(setup)?\.exe$</field>
    <description>OneDrive accessed explorer.exe (known benign, suppressed)</description>
  </rule>
</group>

<!-- ===================================================================== -->
<!--  DELIBERATELY NOT SUPPRESSED - these need review, not suppression:     -->
<!--                                                                        -->
<!--  92213 (level 15) "Executable dropped in folder commonly used by       -->
<!--    malware" - one-off on the DC, 09.10 18:16:59; check targetFilename. -->
<!--  67024 "Service logon from non standard service account" (6x) and a    -->
<!--    System error on the DC 20:15:41-48, during an Nmap RDP scan from    -->
<!--    10.10.30.100 (ET SCAN RDP), i.e. a lab test from Kali.              -->
<!--  sshd/PAM authentication failures from the admin VPN address           -->
<!--    (01:45-04:05), interleaved with manager restarts; the brute-force   -->
<!--    rules stay active.                                                  -->
<!--  opnsense rootcheck (8x level 7) - first scan on FreeBSD, usually a    -->
<!--    false positive; rootcheck.title is needed to write an exception.    -->
<!--  Changes of Services\*\Security (WinDefend, WdFilter), SysmonDrv\      -->
<!--    Parameters, Defender Policy Manager - kept on purpose (tampering).  -->
<!-- ===================================================================== -->
