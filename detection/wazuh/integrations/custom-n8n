#!/var/ossec/framework/python/bin/python3
"""Wazuh integration: send the full alert JSON to an n8n webhook.

integratord calls: custom-n8n <alert_file> <api_key> <hook_url> [options_file]
TLS: verified against /var/ossec/etc/n8n-ca.crt when present (n8n's Caddy root CA).
"""
import json
import os
import sys
import time

import requests

CA_FILE = "/var/ossec/etc/n8n-ca.crt"
LOG_FILE = "/var/ossec/logs/integrations.log"
TIMEOUT = 10


def log(message: str) -> None:
    line = f"{time.strftime('%Y/%m/%d %H:%M:%S')} custom-n8n: {message}\n"
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(line)
    except OSError:
        sys.stderr.write(line)


def main() -> int:
    if len(sys.argv) < 4:
        log(f"ERROR: expected <alert_file> <api_key> <hook_url>, got {len(sys.argv) - 1} argument(s)")
        return 1
    alert_file, token, hook_url = sys.argv[1], sys.argv[2], sys.argv[3]

    # Windows events can contain bytes that are not valid UTF-8 - replace them instead of failing.
    with open(alert_file, "rb") as f:
        alert = json.loads(f.read().decode("utf-8", errors="replace"))

    headers = {"Content-Type": "application/json", "X-Wazuh-Token": token}
    verify = CA_FILE if os.path.isfile(CA_FILE) else True
    rule_id = alert.get("rule", {}).get("id")
    try:
        r = requests.post(hook_url, data=json.dumps(alert).encode("utf-8"),
                          headers=headers, timeout=TIMEOUT, verify=verify)
    except requests.RequestException as e:
        log(f"ERROR alert {alert.get('id')} rule {rule_id}: {type(e).__name__}: {e}")
        return 1
    if r.status_code >= 300:
        log(f"ERROR alert {alert.get('id')} rule {rule_id}: HTTP {r.status_code} {r.text[:200]}")
        return 1
    log(f"sent alert {alert.get('id')} rule {rule_id}: HTTP {r.status_code}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
